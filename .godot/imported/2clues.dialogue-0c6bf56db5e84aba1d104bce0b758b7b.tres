raw_text = "~ start
System: You've completed the office challenges!
System: But some of your earlier decisions made the final test harder.
System: Several openings have appeared, but only one will lead you safely out. The others will send you back to the beginning.
System: You got 2 decisions correct so here are your 2 Cyber Clues.
System: Cyber Clue 1: The safe exit is in the front half of the office.

System: Cyber Clue 2: Look on the right side opposite the office door on the left.

=> END
"
metadata/dialogue_manager_version = "3.10.4"
